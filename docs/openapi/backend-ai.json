          "fallbackReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DISABLED",
                  "DEPENDENCY_UNAVAILABLE",
                  "TIMEOUT",
                  "INVALID_RESPONSE",
                  "OVERLOADED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallbackreason"
          },
          "clarifyingQuestion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reply": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schemaVersion",
          "intent",
          "status",
          "entities",
          "questionCode",
          "fallbackReason",
          "clarifyingQuestion",
          "reply",
          "actions",
          "fieldErrors"
        ]
      },
      "BrowserContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "screen"
        ],
        "properties": {
          "screen": {
            "enum": [
              "HOME",
              "CREDITS",
              "WIZARD",
              "APPLICATIONS",
              "DOCUMENTS"
            ]
          },
          "applicationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "documentId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PublicAssistantRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "context": {
            "$ref": "#/components/schemas/BrowserContext"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "context"
        ],
        "title": "AssistantRequest"
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "schemaVersion",
          "enabled",
          "features"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1"
          },
          "enabled": {
            "type": "boolean"
          },
          "features": {
            "type": "object",
            "required": [
              "goalClassification",
              "assistant"
            ],
            "properties": {
              "goalClassification": {
                "type": "boolean"
              },
              "assistant": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "fieldErrors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      }
    }
  }
