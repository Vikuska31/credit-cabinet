{
  "openapi": "3.1.0",
  "info": {
    "title": "Credit Cabinet AI",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/goals/classify": {
      "post": {
        "summary": "Classify",
        "operationId": "classify_v1_goals_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/assistant": {
      "post": {
        "summary": "Assistant",
        "operationId": "assistant_v1_assistant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AssistantRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "context"
        ],
        "title": "AssistantRequest"
      },
      "AssistantResult": {
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1",
            "title": "Schemaversion"
          },
          "businessUse": {
            "type": "string",
            "enum": [
              "BUSINESS",
              "PERSONAL",
              "MIXED",
              "UNCLEAR",
              "NOT_APPLICABLE"
            ],
            "title": "Businessuse"
          },
          "intent": {
            "type": "string",
            "enum": [
              "START_SELECTION",
              "CONTINUE_DRAFT",
              "OPEN_APPLICATION",
              "SHOW_DOCUMENT",
              "EXPLAIN_TERMS",
              "UNKNOWN",
              "OUT_OF_SCOPE"
            ],
            "title": "Intent"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY",
              "NEEDS_CLARIFICATION",
              "NON_BUSINESS",
              "UNSUPPORTED",
              "UNAVAILABLE"
            ],
            "title": "Status"
          },
          "entities": {
            "$ref": "#/components/schemas/Entities"
          },
          "questionCode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SPECIFY_BUSINESS_USE",
                  "SPECIFY_PURPOSE",
                  "SPECIFY_AMOUNT",
                  "SPECIFY_TERM",
                  "SPECIFY_CURRENCY",
                  "EXCLUDE_PERSONAL_PURPOSE",
                  "SELECT_APPLICATION",
                  "SELECT_DOCUMENT"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Questioncode"
          },
          "explanationTopic": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "RATE",
                  "PAYMENT",
                  "FEE",
                  "DOCUMENTS",
                  "PREVIEW"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanationtopic"
          },
          "targetRef": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Targetref"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Evidence"
          },
          "fallbackReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DISABLED",
                  "DEPENDENCY_UNAVAILABLE",
                  "TIMEOUT",
                  "INVALID_RESPONSE",
                  "OVERLOADED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallbackreason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schemaVersion",
          "businessUse",
          "intent",
          "status",
          "entities",
          "questionCode",
          "explanationTopic",
          "targetRef",
          "evidence",
          "fallbackReason"
        ],
        "title": "AssistantResult"
      },
      "Candidate": {
        "properties": {
          "ref": {
            "type": "string",
            "maxLength": 64,
            "title": "Ref"
          },
          "number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref"
        ],
        "title": "Candidate"
      },
      "Clarification": {
        "properties": {
          "questionCode": {
            "type": "string",
            "enum": [
              "SPECIFY_BUSINESS_USE",
              "SPECIFY_PURPOSE",
              "SPECIFY_AMOUNT",
              "SPECIFY_TERM",
              "SPECIFY_CURRENCY",
              "EXCLUDE_PERSONAL_PURPOSE",
              "SELECT_APPLICATION",
              "SELECT_DOCUMENT"
            ],
            "title": "Questioncode"
          },
          "answer": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questionCode",
          "answer"
        ],
        "title": "Clarification"
      },
      "Context": {
        "properties": {
          "screen": {
            "type": "string",
            "enum": [
              "HOME",
              "CREDITS",
              "WIZARD",
              "APPLICATIONS",
              "DOCUMENTS"
            ],
            "title": "Screen"
          },
          "applications": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Applications"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "screen"
        ],
        "title": "Context"
      },
      "Entities": {
        "properties": {
          "purposeText": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Purposetext"
          },
          "goals": {
            "items": {
              "type": "string",
              "enum": [
                "GOODS",
                "ADVERTISING",
                "EXPENSES",
                "EQUIPMENT",
                "REPAIR"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "title": "Goals"
          },
          "amount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{1,12}(?:\\.\\d{1,2})?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "RUB",
                  "USD",
                  "EUR",
                  "OTHER"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "termMonths": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1200.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Termmonths"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "purposeText",
          "goals",
          "amount",
          "currency",
          "termMonths"
        ],
        "title": "Entities"
      },
      "Evidence": {
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "purposeText",
              "goals",
              "amount",
              "termMonths"
            ],
            "title": "Field"
          },
          "quote": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "quote"
        ],
        "title": "Evidence"
      },
      "GoalEvidence": {
        "properties": {
          "goal": {
            "type": "string",
            "enum": [
              "GOODS",
              "ADVERTISING",
              "EXPENSES",
              "EQUIPMENT",
              "REPAIR"
            ],
            "title": "Goal"
          },
          "quote": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "goal",
          "quote"
        ],
        "title": "GoalEvidence"
      },
      "GoalRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "clarifications": {
            "items": {
              "$ref": "#/components/schemas/Clarification"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Clarifications"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "GoalRequest"
      },
      "GoalResult": {
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1",
            "title": "Schemaversion"
          },
          "businessUse": {
            "type": "string",
            "enum": [
              "BUSINESS",
              "PERSONAL",
              "MIXED",
              "UNCLEAR",
              "NOT_APPLICABLE"
            ],
            "title": "Businessuse"
          },
          "status": {
            "type": "string",
            "enum": [
              "CLASSIFIED",
              "NEEDS_CLARIFICATION",
              "NON_BUSINESS",
              "UNSUPPORTED",
              "UNAVAILABLE"
            ],
            "title": "Status"
          },
          "goals": {
            "items": {
              "type": "string",
              "enum": [
                "GOODS",
                "ADVERTISING",
                "EXPENSES",
                "EQUIPMENT",
                "REPAIR"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "title": "Goals"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "BUSINESS_PURPOSE",
              "PERSONAL_PURPOSE",
              "AMBIGUOUS_PURPOSE",
              "OUTSIDE_TAXONOMY",
              "AI_UNAVAILABLE"
            ],
            "title": "Reasoncode"
          },
          "questionCode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SPECIFY_BUSINESS_USE",
                  "SPECIFY_PURPOSE",
                  "SPECIFY_AMOUNT",
                  "SPECIFY_TERM",
                  "SPECIFY_CURRENCY",
                  "EXCLUDE_PERSONAL_PURPOSE",
                  "SELECT_APPLICATION",
                  "SELECT_DOCUMENT"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Questioncode"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/GoalEvidence"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Evidence"
          },
          "fallbackReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DISABLED",
                  "DEPENDENCY_UNAVAILABLE",
                  "TIMEOUT",
                  "INVALID_RESPONSE",
                  "OVERLOADED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallbackreason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schemaVersion",
          "businessUse",
          "status",
          "goals",
          "reasonCode",
          "questionCode",
          "evidence",
          "fallbackReason"
        ],
        "title": "GoalResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "HistoryMessage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
